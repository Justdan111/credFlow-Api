# Copy to .env and fill in for local development.
# Never commit a populated .env.

PORT=8080
APP_ENV=development

# Postgres connection URI. Format: postgres://USER:PASS@HOST:PORT/DB?opts
# For the local Docker setup, see the README ("Getting started").
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/credflow?sslmode=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Generate via: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTES

# Access-token lifetime. Deliberately short: a stolen access token is only
# useful inside this window. Clients call POST /api/auth/refresh to renew.
JWT_TTL=15m

# Refresh-token lifetime (per token, refreshed on every rotation) and the hard
# ceiling on a whole session, which rotation cannot extend.
REFRESH_TTL=720h
REFRESH_ABSOLUTE_TTL=2160h

# Comma-separated exact origins allowed to call the API with credentials.
# Never "*" — browsers reject a wildcard alongside credentialed requests.
ALLOWED_ORIGINS=http://localhost:5173

# Send the refresh cookie only over HTTPS. Set false for local http dev.
COOKIE_SECURE=false
